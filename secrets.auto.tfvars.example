# このファイルを secrets.auto.tfvars にコピーして使ってください。
# secrets.auto.tfvars は .gitignore 済み（*.auto.tfvars）なのでコミットされません。
# ファイル名が .auto.tfvars で終わるため、terraform が自動で読み込みます。
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# bastion_sku = "Developer"（既定）のままなら、この値は使われないので未設定でも動きます。
# bastion_sku = "Basic" に変更する場合のみ必須です。
#
# 下記はドキュメント用のダミー値（RFC 5737）です。自分のグローバル IP に置き換えてください。
# 確認方法: curl -s https://ifconfig.me

allowed_source_ip = "203.0.113.10"
